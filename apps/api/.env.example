# Atlas API — environment configuration
#
# Copy this to `.env` and tweak. The defaults (no .env at all) make Atlas
# run fully offline: SQLite + deterministic embeddings + echo summaries.

# ── Persistence ───────────────────────────────────────────────────────────
# SQLite (default — zero-config dev):
DATABASE_URL="file:./dev.db"

# Postgres + pgvector (production):
#   docker compose up -d
#   DATABASE_URL="postgresql://atlas:atlas@localhost:5432/atlas?schema=public" \
#     pnpm prisma:migrate:dev
# DATABASE_URL="postgresql://atlas:atlas@localhost:5432/atlas?schema=public"

# ── AI (optional) ─────────────────────────────────────────────────────────
# Without these, Atlas uses deterministic-hash embeddings + an offline
# echo summary that's honest about being offline.
#
# ATLAS_AI_COMPLETION selects the LLM:
#   echo       (default)          → no-cost placeholder
#   ollama                        → local LLM (free, offline, private)
#   anthropic                     → Claude via API (best quality, paid)

# ── Option A · Ollama (free, local, no API key) ───────────────────────
# 1) Install:    brew install ollama && ollama serve &
# 2) Pull model: ollama pull llama3.2:3b     # ~2GB, fast on M-series
#                ollama pull qwen2.5:7b      # ~5GB, better quality
# 3) Activate:
# ATLAS_AI_COMPLETION=ollama
# ATLAS_AI_OLLAMA_MODEL=llama3.2:3b
# ATLAS_AI_OLLAMA_URL=http://localhost:11434

# ── Option B · Anthropic Claude (paid, top quality) ───────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ATLAS_AI_COMPLETION=anthropic
# ATLAS_AI_MODEL=claude-3-5-sonnet-latest

# Embeddings — currently only "deterministic" is wired in. Swap to a
# real provider by implementing in packages/ai/src/providers/.
ATLAS_AI_EMBEDDING=deterministic

# ── Server ────────────────────────────────────────────────────────────────
PORT=4001
CORS_ORIGINS=http://localhost:3001
