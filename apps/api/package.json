{
  "name": "@atlas/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node --require @swc-node/register src/main.ts",
    "build": "nest build",
    "start": "node --require @swc-node/register src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev --name init",
    "prisma:reset": "prisma migrate reset --force",
    "prisma:seed": "node --require @swc-node/register prisma/seed.ts",
    "lint": "echo 'no lint'",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@atlas/ai": "workspace:*",
    "@atlas/crdt": "workspace:*",
    "@atlas/types": "workspace:*",
    "@nestjs/common": "^10.4.6",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.6",
    "@nestjs/platform-express": "^10.4.6",
    "@nestjs/websockets": "^10.4.6",
    "@nestjs/platform-ws": "^10.4.6",
    "@prisma/client": "^5.21.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.18.0",
    "yjs": "^13.6.20",
    "zod": "^3.23.8"
  },
  "prisma": {
    "seed": "node --require @swc-node/register prisma/seed.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.6",
    "@swc-node/register": "^1.10.10",
    "@swc/core": "^1.9.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.5",
    "@types/ws": "^8.5.12",
    "prisma": "^5.21.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3"
  }
}
